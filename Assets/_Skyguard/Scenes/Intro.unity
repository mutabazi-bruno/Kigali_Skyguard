  - {fileID: 32900000, guid: 95400174d729d4e42bf754d0aec9ed34, type: 3}
  - {fileID: 32900000, guid: 858ebc2ecaefaf644a2c8daa8ce28b77, type: 3}
  - {fileID: 32900000, guid: cf535859aea29c8488cc32e2400e4396, type: 3}
  playerA: {fileID: 2117218673}
  playerB: {fileID: 2117218672}
  screen: {fileID: 1721259454}
  captionText: {fileID: 1133822099}
  captionGroup: {fileID: 1169621667}
  skipRing: {fileID: 2122395543}
  music: {fileID: 2117218671}
  captions:
  - time: 0.6
    english: Kigali, 2040.
    french: Kigali, 2040.
    kinyarwanda: Kigali, 2040.
  - time: 6.5
    english: KigaliLink drones carry medicine, parcels and data across the hills.
    french: "Les drones KigaliLink transportent m\xE9dicaments, colis et donn\xE9es
      \xE0 travers les collines."
    kinyarwanda: Drone za KigaliLink zitwara imiti, amapaki n'amakuru hirya no hino
      ku misozi.
  - time: 11.6
    english: Tonight a rogue program called HIVE took control of them.
    french: "Cette nuit, un programme pirate appel\xE9 HIVE en a pris le contr\xF4le."
    kinyarwanda: Muri iri joro, porogaramu mbi yitwa HIVE yazigaruriye.
  - time: 16.6
    english: Thousands of drones are heading for the relay towers that keep the city
      online.
    french: "Des milliers de drones foncent vers les tours relais qui gardent la
      ville connect\xE9e."
    kinyarwanda: Ibihumbi bya drone byerekeje ku minara ihuza umujyi n'umuyoboro.
  - time: 22.6
    english: The first tower is already under attack.
    french: "La premi\xE8re tour est d\xE9j\xE0 attaqu\xE9e."
    kinyarwanda: Umunara wa mbere watangiye guterwa.
  - time: 27.6
    english: The Skyguard needs a volunteer.
    french: Les Skyguard ont besoin d'un volontaire.
    kinyarwanda: Skyguard ikeneye umukorerabushake.
  - time: 33.7
    english: One blaster. One night.
    french: Un blaster. Une nuit.
    kinyarwanda: Imbunda imwe. Ijoro rimwe.
  - time: 40.5
    english: Hold the towers until dawn.
    french: "Tiens les tours jusqu'\xE0 l'aube."
    kinyarwanda: Rinda iminara kugeza bucyeye.
  holdToSkip: 1
